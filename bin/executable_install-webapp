#!/bin/bash
# Install a web app as a desktop application using Brave

if [ "$#" -ne 3 ]; then
  echo -e "\e[32mLet's create a new web app you can start from the app launcher.\n\e[0m"
  read -p "Name> " APP_NAME
  read -p "URL> " APP_URL
  read -p "Icon URL> " ICON_URL
else
  APP_NAME="$1"
  APP_URL="$2"
  ICON_URL="$3"
fi

if [[ -z "$APP_NAME" || -z "$APP_URL" || -z "$ICON_URL" ]]; then
  echo "You must set app name, app URL, and icon URL!"
  exit 1
fi

# Create a safe class name (lowercase, no spaces)
APP_CLASS=$(echo "$APP_NAME" | tr '[:upper:]' '[:lower:]' | tr -d ' ' | tr -cd 'a-z0-9_-')

# Extract hostname from URL for WM_CLASS (Brave uses hostname as instance name)
APP_HOSTNAME=$(echo "$APP_URL" | sed -E 's|^https?://||' | sed -E 's|/.*||' | sed -E 's|:.*||')

ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_FILE="$HOME/.local/share/applications/$APP_NAME.desktop"
ICON_PATH="$ICON_DIR/$APP_NAME.png"

mkdir -p "$ICON_DIR"

echo "Downloading icon..."
if ! curl -sL -o "$ICON_PATH" "$ICON_URL"; then
  echo "Error: Failed to download icon."
  exit 1
fi

cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=$APP_NAME
Comment=$APP_NAME
Exec=$HOME/bin/launch-webapp $APP_URL $APP_CLASS
Terminal=false
Type=Application
Icon=$ICON_PATH
StartupNotify=true
StartupWMClass=$APP_HOSTNAME
Categories=Network;WebBrowser;
EOF

chmod +x "$DESKTOP_FILE"

echo -e "\e[32m✓ $APP_NAME installed!\nYou can now find it in your app launcher.\e[0m"
