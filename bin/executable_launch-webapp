#!/bin/bash
# Launch the passed in URL as a web app in Brave
# Usage: launch-webapp <url> <app-class-name>

BROWSER_BIN=$(which brave-browser 2>/dev/null || which brave 2>/dev/null)

if [ -z "$BROWSER_BIN" ]; then
  echo "Error: Brave browser not found!"
  exit 1
fi

if [ -n "$2" ]; then
  exec setsid "$BROWSER_BIN" --app="$1" --class="webapp-$2" "${@:3}"
else
  exec setsid "$BROWSER_BIN" --app="$1" "${@:2}"
fi
